      "title": "Baseline Commit"
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "create": {
      "items": {
        "type": "string"
      },
      "title": "Create",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
