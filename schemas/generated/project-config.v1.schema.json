{
  "$defs": {
    "FeatureFlags": {
      "additionalProperties": false,
      "properties": {
        "graphify": {
          "default": false,
          "title": "Graphify",
          "type": "boolean"
        },
        "spec_kit": {
          "default": true,
          "title": "Spec Kit",
          "type": "boolean"
        }
      },
      "title": "FeatureFlags",
      "type": "object"
    },
    "KnowledgeConfig": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/KnowledgeRoleBinding"
        },
        "constraints": {
          "$ref": "#/$defs/KnowledgeRoleBinding"
        },
        "decisions": {
          "$ref": "#/$defs/KnowledgeRoleBinding"
        },
        "project_overview": {
          "$ref": "#/$defs/KnowledgeRoleBinding"
        },
        "roadmap": {
          "$ref": "#/$defs/KnowledgeRoleBinding"
        }
      },
      "title": "KnowledgeConfig",
      "type": "object"
    },
    "KnowledgeRoleBinding": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "KnowledgeRoleBinding",
      "type": "object"
    },
    "ModelProfile": {
      "enum": [
        "economical",
        "balanced",
        "strong",
        "deep"
      ],
      "title": "ModelProfile",
      "type": "string"
    },
    "ModelProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "default": "codex",
          "title": "Provider",
          "type": "string"
        },
        "reasoning": {
          "$ref": "#/$defs/ReasoningLevel"
        }
      },
      "required": [
        "reasoning"
      ],
      "title": "ModelProfileConfig",
      "type": "object"
    },
    "ProjectIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "profile": {
          "default": "generic",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ProjectIdentity",
      "type": "object"
    },
    "ProjectPaths": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "default": "docs/CONSTRAINTS.md",
          "title": "Constraints",
          "type": "string"
        },
        "evidence": {
          "default": "evidence",
          "title": "Evidence",
          "type": "string"
        },
        "generated": {
          "default": "docs/generated",
          "title": "Generated",
          "type": "string"
        },
        "project": {
          "default": "docs/PROJECT.md",
          "title": "Project",
          "type": "string"
        },
        "roadmap": {
          "default": "docs/ROADMAP.md",
          "title": "Roadmap",
          "type": "string"
        },
        "specs": {
          "default": "specs",
          "title": "Specs",
          "type": "string"
        }
      },
      "title": "ProjectPaths",
      "type": "object"
    },
    "QuotaMode": {
      "enum": [
        "normal",
        "conservation",
        "critical",
        "unknown"
      ],
      "title": "QuotaMode",
      "type": "string"
    },
    "QuotaPolicy": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "default": "openai-default",
          "title": "Account",
          "type": "string"
        },
        "max_snapshot_age_seconds": {
          "default": 900,
          "minimum": 1,
          "title": "Max Snapshot Age Seconds",
          "type": "integer"
        },
        "reserve": {
          "$ref": "#/$defs/QuotaReserve"
        },
        "resource_requirements": {
          "$ref": "#/$defs/ResourceBudgetPolicy"
        },
        "thresholds": {
          "$ref": "#/$defs/QuotaThresholds"
        },
        "unknown_quota_mode": {
          "$ref": "#/$defs/QuotaMode",
          "default": "conservation"
        }
      },
      "title": "QuotaPolicy",
      "type": "object"
    },
    "QuotaReserve": {
      "additionalProperties": false,
      "properties": {
        "five_hour": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Five Hour",
          "type": "number"
        },
        "weekly": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weekly",
          "type": "number"
        }
      },
      "title": "QuotaReserve",
      "type": "object"
    },
    "QuotaThresholds": {
      "additionalProperties": false,
      "properties": {
        "conservation_five_hour_below": {
          "default": 0.35,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Conservation Five Hour Below",
          "type": "number"
        },
        "conservation_weekly_below": {
          "default": 0.3,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Conservation Weekly Below",
          "type": "number"
        },
        "critical_weekly_below": {
          "default": 0.12,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Critical Weekly Below",
          "type": "number"
        }
      },
      "title": "QuotaThresholds",
      "type": "object"
    },
    "ReasoningLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ReasoningLevel",
      "type": "string"
    },
    "ResourceBudgetPolicy": {
      "additionalProperties": false,
      "properties": {
        "deep": {
          "$ref": "#/$defs/ResourceBudgetRequirement"
        },
        "large": {
          "$ref": "#/$defs/ResourceBudgetRequirement"
        },
        "medium": {
          "$ref": "#/$defs/ResourceBudgetRequirement"
        },
        "small": {
          "$ref": "#/$defs/ResourceBudgetRequirement"
        },
        "trivial": {
          "$ref": "#/$defs/ResourceBudgetRequirement"
        }
      },
      "title": "ResourceBudgetPolicy",
      "type": "object"
    },
    "ResourceBudgetRequirement": {
      "additionalProperties": false,
      "properties": {
        "min_five_hour": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Five Hour",
          "type": "number"
        },
        "min_weekly": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Weekly",
          "type": "number"
        }
      },
      "required": [
        "min_five_hour",
        "min_weekly"
      ],
      "title": "ResourceBudgetRequirement",
      "type": "object"
    },
    "SchedulerConfig": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "default": "weighted_v1",
          "title": "Policy",
          "type": "string"
        },
        "policy_version": {
          "default": 1,
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "score_precision": {
          "default": 6,
          "maximum": 12,
          "minimum": 0,
          "title": "Score Precision",
          "type": "integer"
        },
        "weights": {
          "$ref": "#/$defs/SchedulerWeights"
        }
      },
      "title": "SchedulerConfig",
      "type": "object"
    },
    "SchedulerWeights": {
      "additionalProperties": false,
      "properties": {
        "age_bonus": {
          "default": 1.0,
          "title": "Age Bonus",
          "type": "number"
        },
        "information_gain": {
          "default": 1.0,
          "title": "Information Gain",
          "type": "number"
        },
        "milestone_relevance": {
          "default": 1.0,
          "title": "Milestone Relevance",
          "type": "number"
        },
        "priority": {
          "default": 1.0,
          "title": "Priority",
          "type": "number"
        },
        "quota_penalty": {
          "default": 1.0,
          "title": "Quota Penalty",
          "type": "number"
        },
        "resource_penalty": {
          "default": 1.0,
          "title": "Resource Penalty",
          "type": "number"
        },
        "risk_penalty": {
          "default": 1.0,
          "title": "Risk Penalty",
          "type": "number"
        },
        "unblock_value": {
          "default": 1.0,
          "title": "Unblock Value",
          "type": "number"
        },
        "urgency": {
          "default": 1.0,
          "title": "Urgency",
          "type": "number"
        }
      },
      "title": "SchedulerWeights",
      "type": "object"
    },
    "TaskStoreConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "beads",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "TaskStoreConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "features": {
      "$ref": "#/$defs/FeatureFlags"
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeConfig"
    },
    "model_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelProfileConfig"
      },
      "propertyNames": {
        "$ref": "#/$defs/ModelProfile"
      },
      "title": "Model Profiles",
      "type": "object"
    },
    "paths": {
      "$ref": "#/$defs/ProjectPaths"
    },
    "project": {
      "$ref": "#/$defs/ProjectIdentity"
    },
    "quota": {
      "$ref": "#/$defs/QuotaPolicy"
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerConfig"
    },
    "schema_kind": {
      "const": "projectctl.project_config",
      "default": "projectctl.project_config",
      "title": "Schema Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_store": {
      "$ref": "#/$defs/TaskStoreConfig"
    }
  },
  "required": [
    "project"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
