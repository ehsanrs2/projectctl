{
  "$defs": {
    "KnowledgeBinding": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "title": "KnowledgeBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adopted_at": {
      "format": "date-time",
      "title": "Adopted At",
      "type": "string"
    },
    "baseline_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Commit"
    },
    "created": {
      "items": {
        "type": "string"
      },
      "title": "Created",
      "type": "array"
    },
    "knowledge_bindings": {
      "items": {
        "$ref": "#/$defs/KnowledgeBinding"
      },
      "title": "Knowledge Bindings",
      "type": "array"
    },
    "mode": {
      "const": "brownfield",
      "default": "brownfield",
      "title": "Mode",
      "type": "string"
    },
    "preserved": {
      "items": {
        "type": "string"
      },
      "title": "Preserved",
      "type": "array"
    },
    "repository_fingerprint": {
      "title": "Repository Fingerprint",
      "type": "string"
    },
    "schema_kind": {
      "const": "projectctl.adoption_manifest",
      "default": "projectctl.adoption_manifest",
      "title": "Schema Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_store_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Store Provider"
    },
    "unresolved_decisions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Decisions",
      "type": "array"
    }
  },
  "required": [
    "adopted_at",
    "repository_fingerprint"
  ],
  "title": "AdoptionManifest",
  "type": "object"
}
