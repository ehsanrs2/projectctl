{
  "$defs": {
    "ModelProfile": {
      "enum": [
        "economical",
        "balanced",
        "strong",
        "deep"
      ],
      "title": "ModelProfile",
      "type": "string"
    },
    "ReasoningLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ReasoningLevel",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "planned",
        "running",
        "checkpointed",
        "verifying",
        "passed",
        "failed",
        "cancelled",
        "abandoned"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "WorkerDescriptor": {
      "additionalProperties": false,
      "properties": {
        "actual_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Model"
        },
        "model_profile": {
          "$ref": "#/$defs/ModelProfile"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "reasoning": {
          "$ref": "#/$defs/ReasoningLevel"
        }
      },
      "required": [
        "provider",
        "model_profile",
        "reasoning"
      ],
      "title": "WorkerDescriptor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Commit"
    },
    "checkpoint_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "context_manifest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Manifest"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_kind": {
      "const": "projectctl.run_manifest",
      "default": "projectctl.run_manifest",
      "title": "Schema Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "planned"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "worker": {
      "$ref": "#/$defs/WorkerDescriptor"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "worker"
  ],
  "title": "RunManifest",
  "type": "object"
}
