    },
    "classification": {
      "title": "Classification",
      "type": "string"
    },
    "confidence": {
      "title": "Confidence",
      "type": "string"
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "detected_task_systems": {
      "items": {
        "type": "string"
      },
      "title": "Detected Task Systems",
      "type": "array"
    },
    "dirty": {
      "default": false,
      "title": "Dirty",
      "type": "boolean"
    },
    "evidence_score": {
      "default": 0,
