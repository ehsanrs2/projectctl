{
  "$defs": {
    "EligibilityResult": {
      "additionalProperties": false,
      "properties": {
        "eligible": {"title": "Eligible", "type": "boolean"},
        "reasons": {"items": {"$ref": "#/$defs/ExclusionReason"}, "title": "Reasons", "type": "array"},
        "task_id": {"title": "Task Id", "type": "string"}
      },
      "required": ["task_id", "eligible"],
      "title": "EligibilityResult",
      "type": "object"
    },
    "ExclusionReason": {"enum": ["not_ready", "blocked", "human_decision_required", "quota_insufficient", "quota_unknown", "missing_spec", "policy_violation", "invalid_task", "stale_task_snapshot"], "title": "ExclusionReason", "type": "string"},
    "ModelProfile": {"enum": ["economical", "balanced", "strong", "deep"], "title": "ModelProfile", "type": "string"},
    "ModelRecommendation": {
      "additionalProperties": false,
      "properties": {
        "profile": {"$ref": "#/$defs/ModelProfile"},
        "quota_mode": {"$ref": "#/$defs/QuotaMode"},
        "reasoning": {"$ref": "#/$defs/ReasoningLevel"},
        "reasons": {"items": {"$ref": "#/$defs/RecommendationReason"}, "title": "Reasons", "type": "array"}
      },
      "required": ["profile", "reasoning", "quota_mode"],
      "title": "ModelRecommendation",
      "type": "object"
    },
    "QuotaMode": {"enum": ["normal", "conservation", "critical", "unknown"], "title": "QuotaMode", "type": "string"},
    "ReasoningLevel": {"enum": ["low", "medium", "high"], "title": "ReasoningLevel", "type": "string"},
    "RecommendationReason": {"enum": ["task_complexity", "high_risk", "low_quota", "architecture_task", "research_task", "default_policy"], "title": "RecommendationReason", "type": "string"},
    "SchedulerCandidate": {
      "additionalProperties": false,
      "properties": {
        "eligibility": {"$ref": "#/$defs/EligibilityResult"},
        "model": {"anyOf": [{"$ref": "#/$defs/ModelRecommendation"}, {"type": "null"}], "default": null},
        "score": {"anyOf": [{"$ref": "#/$defs/ScoreBreakdown"}, {"type": "null"}], "default": null},
        "task_id": {"title": "Task Id", "type": "string"}
      },
      "required": ["task_id", "eligibility"],
      "title": "SchedulerCandidate",
      "type": "object"
    },
    "ScoreBreakdown": {
      "additionalProperties": false,
      "properties": {
        "age_bonus": {"default": 0.0, "title": "Age Bonus", "type": "number"},
        "information_gain": {"default": 0.0, "title": "Information Gain", "type": "number"},
        "milestone_relevance": {"default": 0.0, "title": "Milestone Relevance", "type": "number"},
        "priority": {"default": 0.0, "title": "Priority", "type": "number"},
        "quota_penalty": {"default": 0.0, "title": "Quota Penalty", "type": "number"},
        "resource_penalty": {"default": 0.0, "title": "Resource Penalty", "type": "number"},
        "risk_penalty": {"default": 0.0, "title": "Risk Penalty", "type": "number"},
        "total": {"title": "Total", "type": "number"},
        "unblock_value": {"default": 0.0, "title": "Unblock Value", "type": "number"},
        "urgency": {"default": 0.0, "title": "Urgency", "type": "number"}
      },
      "required": ["total"],
      "title": "ScoreBreakdown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_milestone_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Active Milestone Id"},
    "candidates": {"items": {"$ref": "#/$defs/SchedulerCandidate"}, "title": "Candidates", "type": "array"},
    "config_digest": {"title": "Config Digest", "type": "string"},
    "evaluated_at": {"format": "date-time", "title": "Evaluated At", "type": "string"},
    "policy": {"title": "Policy", "type": "string"},
    "policy_version": {"title": "Policy Version", "type": "integer"},
    "project_id": {"title": "Project Id", "type": "string"},
    "project_state_digest": {"title": "Project State Digest", "type": "string"},
    "quota_mode": {"$ref": "#/$defs/QuotaMode"},
    "quota_snapshot_digest": {"title": "Quota Snapshot Digest", "type": "string"},
    "schema_kind": {"const": "projectctl.scheduler_decision", "default": "projectctl.scheduler_decision", "title": "Schema Kind", "type": "string"},
    "schema_version": {"const": 2, "default": 2, "title": "Schema Version", "type": "integer"},
    "selected_task_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Selected Task Id"},
    "task_snapshot_digest": {"title": "Task Snapshot Digest", "type": "string"}
  },
  "required": ["evaluated_at", "project_id", "policy", "policy_version", "config_digest", "project_state_digest", "task_snapshot_digest", "quota_snapshot_digest", "quota_mode"],
  "title": "SchedulerDecision",
  "type": "object"
}
